{
  "name": "expensetracker",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "jaeger": "./run jaeger",
    "jaeger:clean": "./run jaeger --clean",
    "jaeger:start": "./run jaeger --start",
    "jaeger:status": "./run jaeger --status",
    "jaeger:stop": "./run jaeger --stop",
    "benchmark": "node scripts/tools/parse-cli.js --benchmark",
    "lint": "node scripts/tools/check-import-boundaries.js && eslint .",
    "parse": "./run parse",
    "postinstall": "node scripts/setup/setup-android.js && patch-package",
    "setup:android": "node scripts/setup/setup-android.js",
    "start": "react-native start",
    "test": "jest",
    "test:collect": "python3 scripts/simulator/collect-testcases.py",
    "test:simulate": "./run test --simulate"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.85.3",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/material-top-tabs": "^7.4.27",
    "@react-navigation/native": "^7.2.4",
    "llama.rn": "0.12.9",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-contacts": "^8.0.10",
    "react-native-fs": "2.20.0",
    "react-native-pager-view": "^8.0.1",
    "react-native-quick-sqlite": "^8.2.7",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "mxgraph": "^4.2.2",
    "patch-package": "8.0.1",
    "prettier": "2.8.8",
    "puppeteer-core": "^25.0.4",
    "react-test-renderer": "19.2.3",
